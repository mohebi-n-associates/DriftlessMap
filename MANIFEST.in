# Files added to the source distribution beyond the package itself.
# Package data installed with DriftlessMap is declared in pyproject.toml.
include AUTHOR.txt
include CITATION.cff
include CONTRIBUTING.md
include CONTRIBUTORS.md
include LICENSE.txt
include MANIFEST.in
include MANUAL.md
include ORIGINS.md
include pyproject.toml
include README.md
include setup.py
include THANKS.txt
include UpdateLog.md
include WhatsNew.md

include driftlessmap/main_window.ui
include driftlessmap/data/query.csv
include driftlessmap/data/atlas_labels.pkl

recursive-include driftlessmap/icons *.svg *.png *.ico *.icns
recursive-include driftlessmap/qss *.qss

# The regression suite, so the sdist can be tested after download.
recursive-include tests *.py

global-exclude .DS_Store *.py[cod]
